# PostgreSQL local (usado quando DATABASE_URL não está definida)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=barberflow
DB_PASSWORD=admin
DB_PORT=5432

# Neon (nuvem) — define esta para usar o banco da Neon; ela tem precedência
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/barberflow?sslmode=require

# Segredo do JWT (obrigatório em produção)
JWT_SECRET=troque-por-um-segredo-forte

# Porta HTTP do backend (default 3000)
PORT=3000

# Domínio(s) permitido(s) no CORS, separados por vírgula.
# Ex.: https://barberflow.vercel.app,https://barberflow-seu-usuario.vercel.app
CORS_ORIGIN=https://barberflow.vercel.app
